<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">
    <changeSet id="2026-06-21" author="6londo9">
        <!-- Create new ids -->
        <addColumn tableName="notifications">
            <column name="id" type="bigint"/>
        </addColumn>
        <sql>
            CREATE SEQUENCE IF NOT EXISTS public.notifications_id_backfill_seq;
        </sql>
        <sql>
            UPDATE public.notifications
            SET id = nextval('public.notifications_id_backfill_seq')
            WHERE id IS NULL;
        </sql>
        <sql>
            ALTER TABLE public.notifications
                ALTER COLUMN id SET NOT NULL;
        </sql>
        <sql>
            ALTER TABLE public.notifications
            ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;
        </sql>
        <sql>
            SELECT setval(
                           pg_get_serial_sequence('public.notifications', 'id'),
                           COALESCE((SELECT MAX(id) FROM public.notifications), 0) + 1,
                           false
                   );
        </sql>
        <sql>
            DROP SEQUENCE IF EXISTS public.notifications_id_backfill_seq;
        </sql>
        <addNotNullConstraint tableName="notifications" columnName="id"/>
        <addColumn tableName="notifications_inbox">
            <column name="notification_id" type="bigint"/>
        </addColumn>
        <sql>
            UPDATE public.notifications_inbox ni
            SET notification_id = n.id
                FROM public.notifications n
            WHERE n.user_id = ni.user_id
              AND n.task_id = ni.task_id
              AND ni.notification_id IS NULL;
        </sql>

        <!-- Drop foreign keys -->
        <dropForeignKeyConstraint baseTableName="notifications_inbox" constraintName="fk__notifications_inbox_to_notifications"/>
        <dropForeignKeyConstraint baseTableName="notifications" constraintName="fk__notifications_task_id"/>

        <!-- Drop primary keys and set new -->
        <addNotNullConstraint tableName="notifications_inbox" columnName="notification_id"/>
        <dropPrimaryKey tableName="notifications_inbox"/>
        <addPrimaryKey tableName="notifications_inbox" columnNames="notification_id"/>
        <dropPrimaryKey tableName="notifications"/>
        <addPrimaryKey tableName="notifications" columnNames="id"/>

        <!-- Add foreign keys -->
        <addForeignKeyConstraint baseTableName="notifications_inbox" baseColumnNames="notification_id"
                                 constraintName="fk__notifications_inbox_to_notifications"
                                 referencedTableName="notifications"
                                 referencedColumnNames="id"/>


        <!-- Drop unused columns and add new ones -->
        <addColumn tableName="notifications">
            <column name="message" type="varchar(300)"/>
        </addColumn>
        <sql>
            UPDATE public.notifications n
            SET message = 'Task ' || t.id || ', user ' || t.user_id || ', status ' || t.status || ', result ' || t.result
                FROM public.tasks t
            WHERE n.task_id = t.id
        </sql>
        <dropColumn tableName="notifications" columnName="task_id"/>
        <dropColumn tableName="notifications_inbox" columnName="task_id"/>
        <dropColumn tableName="notifications_inbox" columnName="user_id"/>
        <addNotNullConstraint tableName="notifications" columnName="message"/>
    </changeSet>
</databaseChangeLog>